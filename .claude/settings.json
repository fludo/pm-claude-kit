{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Edit(/docs/**)",
      "Edit(/project-context.md)",
      "Edit(/project-status.md)",
      "Read(~/.claude/plugins/cache/pm-claude-kit/**)"
    ],
    "ask": [
      "WebFetch",
      "WebSearch"
    ],
    "deny": [
      "Read(/.env)",
      "Read(/.env.*)",
      "Read(/**/.env)",
      "Read(/**/.env.*)",
      "Read(/**/*.pem)",
      "Read(/**/*.key)",
      "Read(/secrets/**)"
    ]
  }
}
